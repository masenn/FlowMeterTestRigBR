    "from pyModbusTCP.client import ModbusClient\n",
    "\n",
    "c = ModbusClient(host='172.16.100.50',port=502,unit_id=1,auto_open=True,auto_close=True)\n",
    "c.write_single_register(102,35)\n",
    "regs = c.read_holding_registers(101,3)\n",
    "print(regs)\n",
    "\n"
   ]
